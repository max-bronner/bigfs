// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"dependsOn": ["watch:esbuild", "watch:tsc"],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch:esbuild",
			"type": "npm",
			"script": "watch:esbuild",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"problemMatcher": {
				"owner": "esbuild",
				"fileLocation": "relative",
				"pattern": [
					{
						"regexp": "^\\[ERROR\\] (.*)$",
						"message": 1
					},
					{
						"regexp": "^    (.*):(\\d+):(\\d+):$",
						"file": 1,
						"line": 2,
						"column": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": "\\[watch\\] build started",
					"endsPattern": "\\[watch\\] build finished"
				}
			}
		},
		{
			"label": "watch:tsc",
			"type": "npm",
			"script": "watch:tsc",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"problemMatcher": "$tsc-watch"
		}
	]
}
