{
  "name": "bigfs",
  "displayName": "bigFS",
  "description": "Browse and edit BIG archives directly in VS Code",
  "version": "0.0.1",
  "publisher": "max-bronner",
  "repository": {
    "type": "git",
    "url": "https://github.com/max-bronner/bigfs.git"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "big",
    "archive",
    "battle for middle earth",
    "bfme",
    "command and conquer",
    "c&c",
    "ea games",
    "modding"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:bigfs"
  ],
  "main": "./dist/extension.mjs",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "bigArchiveExplorer",
          "name": "BIG Archives",
          "icon": "$(archive)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bigArchiveExplorer",
        "contents": "Open a folder to load the BIG archives inside it.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "Searching for BIG archives...",
        "when": "workbenchState != empty && !bigfs.scanned"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "No BIG archives were found in this folder.\n[Refresh](command:bigfs.refreshArchives)",
        "when": "workbenchState != empty && bigfs.scanned && !bigfs.hasArchives"
      }
    ],
    "commands": [
      {
        "command": "bigfs.refreshArchives",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "bigfs.newFile",
        "title": "New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "bigfs.newFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "bigfs.rename",
        "title": "Rename..."
      },
      {
        "command": "bigfs.delete",
        "title": "Delete"
      },
      {
        "command": "bigfs.addFiles",
        "title": "Add Files..."
      },
      {
        "command": "bigfs.extract",
        "title": "Extract..."
      },
      {
        "command": "bigfs.cut",
        "title": "Cut"
      },
      {
        "command": "bigfs.copy",
        "title": "Copy"
      },
      {
        "command": "bigfs.paste",
        "title": "Paste"
      },
      {
        "command": "bigfs.duplicate",
        "title": "Duplicate"
      },
      {
        "command": "bigfs.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "bigfs.copyRelativePath",
        "title": "Copy Relative Path"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bigfs.refreshArchives",
          "group": "navigation",
          "when": "view == bigArchiveExplorer"
        }
      ],
      "view/item/context": [
        {
          "command": "bigfs.newFile",
          "group": "navigation@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.newFolder",
          "group": "navigation@2",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.addFiles",
          "group": "navigation@3",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.extract",
          "group": "3_extract@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.rename",
          "group": "7_modification@1",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        },
        {
          "command": "bigfs.delete",
          "group": "7_modification@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        },
        {
          "command": "bigfs.cut",
          "group": "5_cutcopypaste@1",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        },
        {
          "command": "bigfs.copy",
          "group": "5_cutcopypaste@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        },
        {
          "command": "bigfs.paste",
          "group": "5_cutcopypaste@3",
          "when": "view == bigArchiveExplorer && bigfs.hasClipboard"
        },
        {
          "command": "bigfs.duplicate",
          "group": "5_cutcopypaste@4",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        },
        {
          "command": "bigfs.copyPath",
          "group": "6_copypath@1",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        },
        {
          "command": "bigfs.copyRelativePath",
          "group": "6_copypath@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        }
      ],
      "commandPalette": [
        {
          "command": "bigfs.refreshArchives",
          "title": "BIG: Refresh Archives"
        },
        {
          "command": "bigfs.newFile",
          "when": "false"
        },
        {
          "command": "bigfs.newFolder",
          "when": "false"
        },
        {
          "command": "bigfs.rename",
          "when": "false"
        },
        {
          "command": "bigfs.delete",
          "when": "false"
        },
        {
          "command": "bigfs.addFiles",
          "when": "false"
        },
        {
          "command": "bigfs.extract",
          "when": "false"
        },
        {
          "command": "bigfs.cut",
          "when": "false"
        },
        {
          "command": "bigfs.copy",
          "when": "false"
        },
        {
          "command": "bigfs.paste",
          "when": "false"
        },
        {
          "command": "bigfs.duplicate",
          "when": "false"
        },
        {
          "command": "bigfs.copyPath",
          "when": "false"
        },
        {
          "command": "bigfs.copyRelativePath",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bigfs.rename",
        "key": "f2",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.delete",
        "key": "delete",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == bigArchiveExplorer && bigfs.hasClipboard"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.mjs",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --preserveWatchOutput --project tsconfig.json",
    "compile-tests": "tsc -p ./ --outDir out",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run test:unit && vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3"
  }
}
