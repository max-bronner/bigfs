{
  "name": "bigfs",
  "displayName": "bigFS",
  "description": "Browse and edit BIG archives directly in VS Code",
  "version": "0.0.1",
  "publisher": "max-bronner",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/max-bronner/bigfs.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "bigFS writes archives, runs the game and FFmpeg, and reads settings that name executables, so it only runs in trusted folders."
    }
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "big",
    "archive",
    "battle for middle earth",
    "bfme",
    "command and conquer",
    "c&c",
    "ea games",
    "modding"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:bigfs"
  ],
  "main": "./dist/extension.mjs",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "bigArchiveExplorer",
          "name": "BIG Archives",
          "icon": "$(archive)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bigArchiveExplorer",
        "contents": "Open a folder to load the BIG archives inside it.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "Searching for BIG archives...",
        "when": "workbenchState != empty && !bigfs.scanned"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "No BIG archives were found in this folder.\n[Refresh](command:bigfs.refreshArchives)",
        "when": "workbenchState != empty && bigfs.scanned && !bigfs.hasArchives"
      }
    ],
    "commands": [
      {
        "command": "bigfs.refreshArchives",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "bigfs.newFile",
        "title": "New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "bigfs.newFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "bigfs.rename",
        "title": "Rename..."
      },
      {
        "command": "bigfs.delete",
        "title": "Delete"
      },
      {
        "command": "bigfs.addFiles",
        "title": "Add Files..."
      },
      {
        "command": "bigfs.extract",
        "title": "Extract..."
      },
      {
        "command": "bigfs.cut",
        "title": "Cut"
      },
      {
        "command": "bigfs.copy",
        "title": "Copy"
      },
      {
        "command": "bigfs.paste",
        "title": "Paste"
      },
      {
        "command": "bigfs.duplicate",
        "title": "Duplicate"
      },
      {
        "command": "bigfs.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "bigfs.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "bigfs.overrideInFolder",
        "title": "Override in Folder..."
      },
      {
        "command": "bigfs.packFolder",
        "title": "Pack into BIG Archive..."
      },
      {
        "command": "bigfs.searchArchives",
        "title": "Search in BIG Archives...",
        "category": "BIG"
      },
      {
        "command": "bigfs.validateIni",
        "title": "Validate INI Files",
        "category": "BIG"
      },
      {
        "command": "bigfs.showGameView",
        "title": "Show What the Game Loads",
        "icon": "$(layers)"
      },
      {
        "command": "bigfs.showArchiveView",
        "title": "Show Every Archive",
        "icon": "$(archive)"
      },
      {
        "command": "bigfs.convertStringTable",
        "title": "Convert String Table (.str ⇄ .csf)",
        "category": "BIG"
      },
      {
        "command": "bigfs.openStringTable",
        "title": "Open as Table",
        "category": "BIG",
        "icon": "$(table)"
      },
      {
        "command": "bigfs.showWndPreview",
        "title": "Show Layout Preview",
        "category": "BIG",
        "icon": "$(open-preview)"
      },
      {
        "command": "bigfs.exportPng",
        "title": "Export as PNG",
        "category": "BIG"
      },
      {
        "command": "bigfs.importImage",
        "title": "Replace with PNG…",
        "category": "BIG"
      },
      {
        "command": "bigfs.convertPng",
        "title": "Convert to Game Texture…",
        "category": "BIG"
      },
      {
        "command": "bigfs.previewParticles",
        "title": "Preview Particle System",
        "category": "BIG"
      },
      {
        "command": "bigfs.newAptMovie",
        "title": "New APT Movie…",
        "category": "BIG"
      },
      {
        "command": "bigfs.compareWithBaseGame",
        "title": "Compare with Base Game",
        "category": "BIG"
      },
      {
        "command": "bigfs.launchGame",
        "title": "Launch Game with Mod",
        "category": "BIG",
        "icon": "$(play)"
      },
      {
        "command": "bigfs.playAudioEvent",
        "title": "Play Audio Event",
        "category": "BIG"
      },
      {
        "command": "bigfs.openBalanceSheet",
        "title": "Open Balance Sheet",
        "category": "BIG"
      },
      {
        "command": "bigfs.duplicateDefinition",
        "title": "Duplicate Definition…",
        "category": "BIG"
      },
      {
        "command": "bigfs.findUnusedDefinitions",
        "title": "Find Unused Definitions",
        "category": "BIG"
      },
      {
        "command": "bigfs.clearUnusedDefinitions",
        "title": "Clear Unused Definitions",
        "category": "BIG"
      },
      {
        "command": "bigfs.convertToVp6",
        "title": "Convert to VP6 Movie…",
        "category": "BIG"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bigfs.refreshArchives",
          "group": "navigation",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.searchArchives",
          "group": "1_search@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.validateIni",
          "group": "1_search@2",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.showGameView",
          "group": "navigation@0",
          "when": "view == bigArchiveExplorer && !bigfs.gameView"
        },
        {
          "command": "bigfs.showArchiveView",
          "group": "navigation@0",
          "when": "view == bigArchiveExplorer && bigfs.gameView"
        }
      ],
      "view/item/context": [
        {
          "command": "bigfs.newFile",
          "group": "navigation@1",
          "when": "view == bigArchiveExplorer && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.newFolder",
          "group": "navigation@2",
          "when": "view == bigArchiveExplorer && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.addFiles",
          "group": "navigation@3",
          "when": "view == bigArchiveExplorer && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.extract",
          "group": "3_extract@1",
          "when": "view == bigArchiveExplorer && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.rename",
          "group": "7_modification@1",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.delete",
          "group": "7_modification@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.cut",
          "group": "5_cutcopypaste@1",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.copy",
          "group": "5_cutcopypaste@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.paste",
          "group": "5_cutcopypaste@3",
          "when": "view == bigArchiveExplorer && bigfs.hasClipboard && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.duplicate",
          "group": "5_cutcopypaste@4",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.copyPath",
          "group": "6_copypath@1",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.copyRelativePath",
          "group": "6_copypath@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigGameFolder && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.overrideInFolder",
          "group": "3_extract@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive && viewItem != bigLooseFile"
        },
        {
          "command": "bigfs.convertStringTable",
          "group": "7_modification@10",
          "when": "view == bigArchiveExplorer && resourceExtname =~ /^\\.(str|csf)$/i"
        },
        {
          "command": "bigfs.exportPng",
          "group": "7_modification@11",
          "when": "view == bigArchiveExplorer && resourceExtname =~ /^\\.(tga|dds)$/i"
        },
        {
          "command": "bigfs.importImage",
          "group": "7_modification@12",
          "when": "view == bigArchiveExplorer && resourceExtname =~ /^\\.(tga|dds)$/i"
        },
        {
          "command": "bigfs.convertPng",
          "group": "7_modification@13",
          "when": "view == bigArchiveExplorer && resourceExtname =~ /^\\.png$/i"
        },
        {
          "command": "bigfs.newAptMovie",
          "group": "7_modification@14",
          "when": "view == bigArchiveExplorer && viewItem =~ /^big(Folder|Archive)$/"
        },
        {
          "command": "bigfs.convertToVp6",
          "group": "7_modification@15",
          "when": "view == bigArchiveExplorer && resourceExtname =~ /^\\.(mp4|m4v|mov|webm|ogv|ogg|mkv|avi|wmv|mpg|mpeg|gif)$/i"
        }
      ],
      "commandPalette": [
        {
          "command": "bigfs.refreshArchives",
          "title": "BIG: Refresh Archives"
        },
        {
          "command": "bigfs.newFile",
          "when": "false"
        },
        {
          "command": "bigfs.newFolder",
          "when": "false"
        },
        {
          "command": "bigfs.rename",
          "when": "false"
        },
        {
          "command": "bigfs.delete",
          "when": "false"
        },
        {
          "command": "bigfs.addFiles",
          "when": "false"
        },
        {
          "command": "bigfs.extract",
          "when": "false"
        },
        {
          "command": "bigfs.cut",
          "when": "false"
        },
        {
          "command": "bigfs.copy",
          "when": "false"
        },
        {
          "command": "bigfs.paste",
          "when": "false"
        },
        {
          "command": "bigfs.duplicate",
          "when": "false"
        },
        {
          "command": "bigfs.copyPath",
          "when": "false"
        },
        {
          "command": "bigfs.copyRelativePath",
          "when": "false"
        },
        {
          "command": "bigfs.overrideInFolder",
          "when": "false"
        },
        {
          "command": "bigfs.packFolder",
          "when": "false"
        },
        {
          "command": "bigfs.openStringTable",
          "when": "editorLangId == sage-str"
        },
        {
          "command": "bigfs.showWndPreview",
          "when": "editorLangId == sage-wnd"
        },
        {
          "command": "bigfs.exportPng",
          "when": "false"
        },
        {
          "command": "bigfs.importImage",
          "when": "false"
        },
        {
          "command": "bigfs.convertPng",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "bigfs.packFolder",
          "group": "7_modification@9",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "bigfs.convertStringTable",
          "group": "7_modification@10",
          "when": "resourceExtname =~ /^\\.(str|csf)$/i"
        },
        {
          "command": "bigfs.exportPng",
          "group": "7_modification@11",
          "when": "resourceExtname =~ /^\\.(tga|dds)$/i"
        },
        {
          "command": "bigfs.importImage",
          "group": "7_modification@12",
          "when": "resourceExtname =~ /^\\.(tga|dds)$/i"
        },
        {
          "command": "bigfs.convertPng",
          "group": "7_modification@13",
          "when": "resourceExtname =~ /^\\.png$/i"
        },
        {
          "command": "bigfs.newAptMovie",
          "group": "7_modification@14",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "bigfs.launchGame",
          "group": "7_modification@20",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "bigfs.convertToVp6",
          "group": "7_modification@15",
          "when": "resourceExtname =~ /^\\.(mp4|m4v|mov|webm|ogv|ogg|mkv|avi|wmv|mpg|mpeg|gif|bik|png|tga|dds)$/i || explorerResourceIsFolder"
        }
      ],
      "editor/title": [
        {
          "command": "bigfs.openStringTable",
          "group": "navigation",
          "when": "editorLangId == sage-str"
        },
        {
          "command": "bigfs.showWndPreview",
          "group": "navigation",
          "when": "editorLangId == sage-wnd"
        }
      ],
      "editor/context": [
        {
          "command": "bigfs.previewParticles",
          "group": "navigation@20",
          "when": "editorLangId == sage-ini"
        },
        {
          "command": "bigfs.duplicateDefinition",
          "group": "1_modification@10",
          "when": "editorLangId == sage-ini"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bigfs.rename",
        "key": "f2",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.delete",
        "key": "delete",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == bigArchiveExplorer && bigfs.hasClipboard"
      }
    ],
    "configuration": {
      "title": "bigFS",
      "properties": {
        "bigfs.ini.game": {
          "type": "string",
          "enum": [
            "rotwk",
            "bfme2",
            "bfme1"
          ],
          "enumDescriptions": [
            "The Rise of the Witch-king",
            "The Battle for Middle-earth II",
            "The Battle for Middle-earth: structure only, since no grammar of its own is available; field names are not checked"
          ],
          "default": "rotwk",
          "description": "The game whose INI grammar checks, completion and hovers follow. The two differ in a few dozen field names."
        },
        "bigfs.ini.checkReferences": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Check references into a kind of definition once the workspace holds at least 50 of them, so the base game's files are there",
            "Always check references, even with only a mod's own files open",
            "Never check references"
          ],
          "default": "auto",
          "description": "Whether a value naming a Weapon, Upgrade, FXList or other definition that nothing in the workspace defines is reported."
        },
        "bigfs.ini.checkAssets": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Check once the archives and folders hold the base game's models, so a missing name is a mistake",
            "Always check, even with only a mod's own files open",
            "Never check"
          ],
          "default": "auto",
          "description": "Whether a model, animation, texture or sound an INI file names, which no archive or folder holds, is reported."
        },
        "bigfs.explorer.view": {
          "type": "string",
          "enum": [
            "archives",
            "game"
          ],
          "enumDescriptions": [
            "Every archive with all of its files",
            "Only the file the game loads at each path, layered by the engine's archive order: loose files before archives, archives sorted by path with the first winning, workspace folders in order with the first winning"
          ],
          "default": "archives",
          "description": "What the BIG Archives view shows."
        },
        "bigfs.baseGameFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Install folder of the unmodded game, which **BIG: Compare with Base Game** compares the workspace against. Asked for on first use."
        },
        "bigfs.game.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The game program **BIG: Launch Game with Mod** starts, such as `lotrbfme2ep1.exe` for The Rise of the Witch-king or `lotrbfme2.exe` for BFME II. Asked for on first use."
        },
        "bigfs.game.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments passed before `-mod`, such as `-win` or `-noshellmap`."
        },
        "bigfs.ini.checkStrings": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Check once the string tables hold at least 1000 records, so the base game's are there",
            "Always check, even with only a mod's own files open",
            "Never check"
          ],
          "default": "auto",
          "description": "Whether a game-text label such as OBJECT:Name that no string table defines is reported."
        },
        "bigfs.ffmpegPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "FFmpeg program **Convert to VP6 Movie** reads videos with. Empty: `ffmpeg` on the PATH; without one, only WebM and Ogg videos (and image frames) can be read."
        },
        "bigfs.vp6.keyFrameSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "markdownDescription": "Seconds between forced key frames when **Convert to VP6 Movie** encodes; scene changes add their own. 0 makes every frame a key frame, which seeks fastest and is largest."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "bigfs.preview",
        "displayName": "bigFS Preview",
        "selector": [
          {
            "filenamePattern": "*.{tga,dds,wav,w3d,mp3,vp6,TGA,DDS,WAV,W3D,MP3,VP6}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "bigfs.aptEditor",
        "displayName": "bigFS APT Movie",
        "selector": [
          {
            "filenamePattern": "*.{apt,APT}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "bigfs.strTable",
        "displayName": "bigFS String Table",
        "selector": [
          {
            "filenamePattern": "*.{str,STR}"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "bigfs.csfEditor",
        "displayName": "bigFS CSF String Table",
        "selector": [
          {
            "filenamePattern": "*.{csf,CSF}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "bigfs.mapEditor",
        "displayName": "bigFS Map",
        "selector": [
          {
            "filenamePattern": "**/{maps,Maps,MAPS}/**/*.{map,MAP}"
          },
          {
            "filenamePattern": "*.{bse,BSE}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "bigfs.mapEditorAny",
        "displayName": "bigFS Map",
        "selector": [
          {
            "filenamePattern": "*.{map,MAP}"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "sage-ini",
        "aliases": [
          "SAGE INI",
          "BFME INI"
        ],
        "extensions": [
          ".inc",
          ".bhav"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sage-str",
        "aliases": [
          "SAGE String Table",
          "BFME STR"
        ],
        "extensions": [
          ".str"
        ],
        "configuration": "./str-language-configuration.json"
      },
      {
        "id": "sage-wnd",
        "aliases": [
          "SAGE Window Layout",
          "WND"
        ],
        "extensions": [
          ".wnd"
        ],
        "configuration": "./wnd-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sage-ini",
        "scopeName": "source.sage-ini",
        "path": "./syntaxes/sageIni.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.lua": "lua"
        }
      },
      {
        "language": "sage-str",
        "scopeName": "source.sage-str",
        "path": "./syntaxes/sageStr.tmLanguage.json"
      },
      {
        "language": "sage-wnd",
        "scopeName": "source.sage-wnd",
        "path": "./syntaxes/sageWnd.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[sage-ini]": {
        "files.encoding": "iso88591"
      },
      "[sage-str]": {
        "files.encoding": "windows1252"
      },
      "[sage-wnd]": {
        "files.encoding": "iso88591"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.mjs",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --preserveWatchOutput --project tsconfig.json",
    "compile-tests": "tsc -p ./ --outDir out",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run test:unit && vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "build:schema": "node scripts/buildSageSchema.mjs",
    "vsix": "vsce package --out bigfs.vsix"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
