{
  "name": "bigfs",
  "displayName": "bigFS",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:bigfs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "bigArchiveExplorer",
          "name": "BIG Archives"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bigArchiveExplorer",
        "contents": "Open a folder to load the BIG archives inside it.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "Searching for BIG archives...",
        "when": "workbenchState != empty && bigfs.scanning"
      },
      {
        "view": "bigArchiveExplorer",
        "contents": "No BIG archives were found in this folder.\n[Refresh](command:bigfs.refreshArchives)",
        "when": "workbenchState != empty && !bigfs.scanning"
      }
    ],
    "commands": [
      {
        "command": "bigfs.refreshArchives",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "bigfs.newFile",
        "title": "New File...",
        "icon": "$(new-file)"
      },
      {
        "command": "bigfs.newFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)"
      },
      {
        "command": "bigfs.rename",
        "title": "Rename..."
      },
      {
        "command": "bigfs.delete",
        "title": "Delete"
      },
      {
        "command": "bigfs.addFiles",
        "title": "Add Files..."
      },
      {
        "command": "bigfs.extract",
        "title": "Extract..."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bigfs.refreshArchives",
          "group": "navigation",
          "when": "view == bigArchiveExplorer"
        }
      ],
      "view/item/context": [
        {
          "command": "bigfs.newFile",
          "group": "navigation@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.newFolder",
          "group": "navigation@2",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.addFiles",
          "group": "navigation@3",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.extract",
          "group": "3_extract@1",
          "when": "view == bigArchiveExplorer"
        },
        {
          "command": "bigfs.rename",
          "group": "7_modification@1",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        },
        {
          "command": "bigfs.delete",
          "group": "7_modification@2",
          "when": "view == bigArchiveExplorer && viewItem != bigArchive"
        }
      ],
      "commandPalette": [
        {
          "command": "bigfs.refreshArchives",
          "title": "BIG: Refresh Archives"
        },
        {
          "command": "bigfs.newFile",
          "when": "false"
        },
        {
          "command": "bigfs.newFolder",
          "when": "false"
        },
        {
          "command": "bigfs.rename",
          "when": "false"
        },
        {
          "command": "bigfs.delete",
          "when": "false"
        },
        {
          "command": "bigfs.addFiles",
          "when": "false"
        },
        {
          "command": "bigfs.extract",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bigfs.rename",
        "key": "f2",
        "when": "focusedView == bigArchiveExplorer"
      },
      {
        "command": "bigfs.delete",
        "key": "delete",
        "when": "focusedView == bigArchiveExplorer"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.8.1",
    "typescript": "~6.0.3"
  }
}
