{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SAGE Window Layout",
  "scopeName": "source.sage-wnd",
  "patterns": [
    { "name": "keyword.control.sage-wnd", "match": "\\b(WINDOW|END|CHILD|ENDALLCHILDREN|STARTLAYOUTBLOCK|ENDLAYOUTBLOCK)\\b(?!\\s*=)" },
    { "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)", "captures": { "1": { "name": "variable.other.property.sage-wnd" }, "2": { "name": "keyword.operator.assignment.sage-wnd" } } },
    { "name": "string.quoted.double.sage-wnd", "match": "\"[^\"]*\"" },
    { "match": "\\b([A-Z][A-Z0-9_]*)(:)", "captures": { "1": { "name": "entity.name.tag.sage-wnd" }, "2": { "name": "punctuation.separator.sage-wnd" } } },
    { "name": "constant.numeric.sage-wnd", "match": "-?\\b\\d+\\b" },
    { "name": "keyword.operator.sage-wnd", "match": "[+;]" },
    { "name": "constant.language.sage-wnd", "match": "\\b[A-Z][A-Z0-9_]+\\b" }
  ]
}
